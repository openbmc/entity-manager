      "writtenOn": "2026-08-24T08:00:30Z",
      "side": 1,
      "message": "This suggests that we shouldn\u0027t be describing endpoints at all, as by doing so we\u0027re then encoding the configuration of the plugged board into the current board, which is against the design point of these configuration files.",
      "range": {
        "startLine": 10,
        "startChar": 66,
        "endLine": 12,
        "endChar": 56
      },
      "revId": "9215f32088ed58f2100c004b43ae10214d35043b",
