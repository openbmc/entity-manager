{
    "Exposes": [
        {
            "Address": "$address",
            "Bus": "$bus",
            "Name": "NVIDIA VR NVL72 IO Board $bus FRU",
            "Type": "EEPROM"
        },
        {
            "Name": "NVIDIA VR NVL72 IO Board CX",
            "PortCount": 2,
            "Type": "NvidiaMctpVdmCx"
        },
        {
            "Name": "NVIDIA VR NVL72 IO Board SMA",
            "Type": "NvidiaMctpVdmSma"
        }
    ],
    "Name": "NVIDIA VR NVL72 IO Board $bus",
    "Probe": "xyz.openbmc_project.FruDevice({'BOARD_PRODUCT_NAME': 'ConnectX-9 (800GE|2x400GE) 2P NIC', 'BOARD_MANUFACTURER': '(Nvidia|NVIDIA)'})",
    "Type": "Board",
    "xyz.openbmc_project.Inventory.Decorator.Asset": {
        "BuildDate": "$BOARD_MANUFACTURE_DATE",
        "Manufacturer": "$BOARD_MANUFACTURER",
        "Model": "$BOARD_PRODUCT_NAME",
        "PartNumber": "$BOARD_PART_NUMBER",
        "SerialNumber": "$BOARD_SERIAL_NUMBER"
    },
    "xyz.openbmc_project.Inventory.Decorator.AssetTag": {
        "AssetTag": "$PRODUCT_ASSET_TAG"
    },
    "xyz.openbmc_project.Inventory.Decorator.Revision": {
        "Version": "$PRODUCT_VERSION"
    }
}
