      "writtenOn": "2026-09-09T00:07:07Z",
      "side": 1,
      "message": "What\u0027s the motivation for this constraint?",
      "revId": "a0bf91c5d6e9e75cbafa3847d39975cead4f365d",
      "serverId": "adbd0a64-1f21-4d83-b585-671fe73cb6e4"
