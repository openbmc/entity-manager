{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$defs": {
        "MCTPI2CTarget": {
            "properties": {
                "Address": {
                    "description": "The physical address for the device on the I2C bus.",
                    "type": "string"
                },
                "Bus": {
                    "description": "The bus index to which the device is attached",
                    "type": ["string", "number"]
                },
                "Name": {
                    "description": "A recognisable name for the device",
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "enum": ["MCTPI2CTarget"]
                }
            },
            "required": ["Address", "Bus", "Name", "Type"],
            "type": "object"
        },
        "MCTPI3CTarget": {
            "properties": {
                "Address": {
                    "description": "The 6-byte PID for the device on the I3C bus",
                    "type": ["string", "array"]
                },
                "Bus": {
                    "description": "The bus index to which the device is attached",
                    "type": ["string", "number"]
                },
                "Name": {
                    "description": "A recognisable name for the device",
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "enum": ["MCTPI3CTarget"]
                }
            },
            "required": ["Address", "Bus", "Name", "Type"],
            "type": "object"
        },
        "MCTPRoutedEndpoint": {
            "properties": {
                "EID": {
                    "description": "The EID already assigned to the endpoint. The route to this EID must be configured independently before the endpoint can be discovered.",
                    "type": ["string", "number"]
                },
                "Name": {
                    "description": "A recognisable name for the endpoint",
                    "type": "string"
                },
                "NetworkId": {
                    "description": "The MCTP network containing the routed endpoint",
                    "type": ["string", "number"]
                },
                "Type": {
                    "type": "string",
                    "enum": ["MCTPRoutedEndpoint"]
                }
            },
            "required": ["EID", "Name", "NetworkId", "Type"],
            "type": "object"
        }
    }
}
