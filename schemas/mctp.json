{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$defs": {
        "MCTPBridgeChild": {
            "description": "A device reachable through an MCTP bridge's downstream EID pool, identified by its offset within that pool rather than a literal EID (which is assigned dynamically and can change across boots).",
            "properties": {
                "Name": {
                    "description": "A recognisable name for the device",
                    "type": "string"
                },
                "NetworkId": {
                    "description": "The MCTP network ID the device's EID belongs to.",
                    "type": "number"
                },
                "PoolOffset": {
                    "description": "The device's EID, expressed as an offset from the bridge's own downstream pool start.",
                    "type": "number"
                },
                "PLDMSensors": {
                    "items": {
                        "properties": {
                            "ID": {
                                "type": "integer"
                            },
                            "Name": {
                                "type": "string"
                            }
                        },
                        "required": ["ID", "Name"],
                        "type": "object"
                    },
                    "type": "array"
                },
                "Type": {
                    "type": "string",
                    "enum": ["MCTPBridgeChild"]
                }
            },
            "required": ["Name", "Type"],
            "type": "object"
        },
        "MCTPI2CTarget": {
            "properties": {
                "Address": {
                    "description": "The physical address for the device on the I2C bus.",
                    "type": "string"
                },
                "Bus": {
                    "description": "The bus index to which the device is attached",
                    "type": ["string", "number"]
                },
                "Name": {
                    "description": "A recognisable name for the device",
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "enum": ["MCTPI2CTarget"]
                }
            },
            "required": ["Address", "Bus", "Name", "Type"],
            "type": "object"
        },
        "MCTPI3CTarget": {
            "properties": {
                "Address": {
                    "description": "The 6-byte PID for the device on the I3C bus",
                    "type": ["string", "array"]
                },
                "Bus": {
                    "description": "The bus index to which the device is attached",
                    "type": ["string", "number"]
                },
                "Name": {
                    "description": "A recognisable name for the device",
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "enum": ["MCTPI3CTarget"]
                }
            },
            "required": ["Address", "Bus", "Name", "Type"],
            "type": "object"
        }
    }
}
