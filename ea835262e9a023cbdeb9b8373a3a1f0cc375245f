    {
      "unresolved": true,
      "key": {
        "uuid": "9ebf641f_794e34e6",
        "filename": "src/entity_manager/perform_probe.cpp",
        "patchSetId": 10
      },
      "lineNbr": 140,
      "author": {
        "id": 1001712
      },
      "writtenOn": "2026-11-16T13:07:50Z",
      "side": 1,
      "message": "\u003e For this change, the plan is to add a small validator that parseProbeCommand calls to reject a misplaced NOT and log the reason. If that direction works, I would send a separate change that checks AND/OR placement in the same validator.\nDoes that fit what you had in mind?\n\nSomewhat. 100% agree we need some validation on the probe statement for the operator placement.\n\nCan we have an recursive descent parser that converts the probe tokens into an AST?\n\nEven though current EM semantics are left-to-right it should still be possible to express with an AST and we do not run the risk of transferring these (broken) left-to-right semantics onto new features such as `NOT` or parentheses support.\n\nhttps://en.wikipedia.org/wiki/Recursive_descent_parser\n\nAn AST should also be much easier to evaluate and we can test it in two parts:\n\n- the tokens are converted to the expected AST structure (here we check associativity and precedence)\n- the AST structure is evaluated to the expected value (here we check correct evaluation)\n\n\nWith the current code the evaluation and precedence as well as operator associativity are all combined into one stateful code.\n\nmy clanker prototyped a proof-of-concept code for what it could look like:\n```\n#pragma once\n\n#include \"entity_manager/probe_lexer.hpp\"\n\n#include \u003cmemory\u003e\n#include \u003coptional\u003e\n#include \u003cvector\u003e\n\nnamespace probe::example\n{\n\n// Leaves own an operand token and have no children. AND/OR nodes own their\n// operator token and both children. MATCH_ONE is metadata, not a boolean node.\nstruct Node\n{\n    Token token;\n    std::unique_ptr\u003cNode\u003e left;\n    std::unique_ptr\u003cNode\u003e right;\n};\n\nstruct Ast\n{\n    std::unique_ptr\u003cNode\u003e root;\n    bool matchOne \u003d false;\n};\n\n// Test-only recursive-descent example for docs/probe_grammar.md:\n//   probe      \u003d expression [ MATCH_ONE ] ;\n//   expression \u003d operand { (AND | OR) operand } ;\n//   operand    \u003d TRUE | FALSE | FOUND(...) | dbus_probe ;\n// AND and OR have equal precedence and associate left: A OR B AND C becomes\n// AND(OR(A, B), C). An evaluator must visit both children, left first, without\n// short-circuiting: D-Bus operands collect devices even if the result is known.\n// Returns an owning AST, or nullopt for empty/malformed input. No production\n// evaluator is called or changed by this example.\nstd::optional\u003cAst\u003e parseProbe(const std::vector\u003cToken\u003e\u0026 tokens);\n\n} // namespace probe::example\n\n#include \"probe_parser.hpp\"\n\n#include \u003ccstddef\u003e\n#include \u003cmemory\u003e\n#include \u003coptional\u003e\n#include \u003cutility\u003e\n#include \u003cvector\u003e\n\nnamespace probe::example\n{\nnamespace\n{\n\nclass Parser\n{\n  public:\n    explicit Parser(const std::vector\u003cToken\u003e\u0026 tokens) : tokens(tokens) {}\n\n    std::optional\u003cAst\u003e parse()\n    {\n        auto root \u003d parseExpression();\n        if (!root)\n        {\n            return std::nullopt;\n        }\n\n        bool matchOne \u003d false;\n        if (position \u003c tokens.size() \u0026\u0026\n            tokens[position].type \u003d\u003d TokenType::matchOne)\n        {\n            matchOne \u003d true;\n            ++position;\n        }\n        if (position !\u003d tokens.size())\n        {\n            return std::nullopt;\n        }\n        return Ast{std::move(root), matchOne};\n    }\n\n  private:\n    const std::vector\u003cToken\u003e\u0026 tokens;\n    std::size_t position \u003d 0;\n\n    std::unique_ptr\u003cNode\u003e parseExpression()\n    {\n        auto left \u003d parseOperand();\n        if (!left)\n        {\n            return nullptr;\n        }\n\n        // Descend through the grammar\u0027s productions, using a loop for its\n        // repetition. Folding the accumulated left subtree avoids accidentally\n        // giving AND precedence or building a right-associative tree.\n        while (position \u003c tokens.size() \u0026\u0026\n               (tokens[position].type \u003d\u003d TokenType::opAnd ||\n                tokens[position].type \u003d\u003d TokenType::opOr))\n        {\n            const Token\u0026 op \u003d tokens[position++];\n            auto right \u003d parseOperand();\n            if (!right)\n            {\n                return nullptr;\n            }\n            left \u003d std::make_unique\u003cNode\u003e(\n                Node{op, std::move(left), std::move(right)});\n        }\n        return left;\n    }\n\n    std::unique_ptr\u003cNode\u003e parseOperand()\n    {\n        if (position \u003d\u003d tokens.size())\n        {\n            return nullptr;\n        }\n        const Token\u0026 token \u003d tokens[position];\n        switch (token.type)\n        {\n            case TokenType::boolTrue:\n            case TokenType::boolFalse:\n            case TokenType::found:\n                break;\n            case TokenType::dbusProbe:\n                if (!token.dbus)\n                {\n                    return nullptr;\n                }\n                break;\n            default:\n                return nullptr;\n        }\n        ++position;\n        return std::make_unique\u003cNode\u003e(Node{token, nullptr, nullptr});\n    }\n};\n\n} // namespace\n\nstd::optional\u003cAst\u003e parseProbe(const std::vector\u003cToken\u003e\u0026 tokens)\n{\n    return Parser(tokens).parse();\n}\n\n} // namespace probe::example\n```\n\nWith such an AST we could have tests that cover converting a list of tokens to the\nright structure and separately test that a given AST evaluates to some value.\n\n\n\nplease let me know your thoughts on the suggested approach.",
      "parentUuid": "2e0c4db8_09844201",
