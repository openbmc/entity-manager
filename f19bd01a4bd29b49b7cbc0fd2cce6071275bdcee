      "writtenOn": "2026-10-28T07:09:38Z",
      "side": 1,
      "message": "Is this the structure you are expecting?\n\n{\n    \"Address\": \"0x20\",\n    \"Bus\": \"9\",\n    \"Name\": \"MMC\",\n    \"PLDMSensorNames\": [\n        \"SensorName1\",\n        \"SensorName2\"\n    ],\n    \"PLDMSensorIDs\": [\n        300,\n        500\n    ],\n    \"Type\": \"MCTPI2CTarget\"\n}",
      "parentUuid": "866b55d6_bbbf77e4",
